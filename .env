# Copy this file to .env and replace the placeholder values.
UNEED_ENV=development
UNEED_DEBUG=false
UNEED_HOST=127.0.0.1
UNEED_PORT=5000
UNEED_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
UNEED_COOKIE_SECURE=false

# Private developer console (port 5001)
UNEED_DEV_HOST=127.0.0.1
UNEED_DEV_PORT=5001
UNEED_DEV_SECRET_KEY=replace-with-a-different-random-secret
UNEED_DEV_KEY=UneedDev123

# SMTP required for registration OTP and password-reset email.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Optional absolute paths. Defaults stay inside this project.
# UNEED_DATABASE_PATH=/absolute/path/to/uneed_users.sqlite3
# UNEED_DSS_CONFIG_PATH=/absolute/path/to/instance/dss_config.json
